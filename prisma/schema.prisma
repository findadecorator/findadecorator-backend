generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String?
  fullName      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  roles         Role[]               @relation("UserRoles")
  permissions   Permission[]         @relation("UserPermissions")
  clientProfile ClientProfile?
  professional  ProfessionalProfile?
  notifications Notification[]
  wallets       Wallet[]
  reports       Report[]             @relation("ReportAuthor")
  auditLogs     AuditLog[]           @relation("AuditLogActor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  users       User[]       @relation("UserRoles")
  permissions Permission[] @relation("RolePermissions")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?
  users       User[]  @relation("UserPermissions")
  roles       Role[]  @relation("RolePermissions")
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  jobs      Job[]
}

model ProfessionalProfile {
  id                String                @id @default(cuid())
  userId            String                @unique
  businessName      String
  verified          Boolean               @default(false)
  qualityScore      Float                 @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id])
  members           ProfessionalMember[]
  services          ProfessionalService[]
  serviceAreas      ServiceArea[]
  availability      Availability[]
  portfolioItems    PortfolioItem[]
  verificationCases VerificationCase[]
}

model ProfessionalMember {
  id             String              @id @default(cuid())
  professionalId String
  userId         String?
  roleName       String
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
}

model Service {
  id        String                @id @default(cuid())
  code      String                @unique
  name      String
  createdAt DateTime              @default(now())
  mappings  ProfessionalService[]
}

model ProfessionalService {
  id             String              @id @default(cuid())
  professionalId String
  serviceId      String
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  service        Service             @relation(fields: [serviceId], references: [id])
}

model ServiceArea {
  id             String              @id @default(cuid())
  professionalId String
  regionCode     String
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
}

model Availability {
  id             String              @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
}

model VerificationCase {
  id             String                 @id @default(cuid())
  professionalId String
  status         String
  createdAt      DateTime               @default(now())
  professional   ProfessionalProfile    @relation(fields: [professionalId], references: [id])
  documents      VerificationDocument[]
  events         VerificationEvent[]
}

model VerificationDocument {
  id                 String           @id @default(cuid())
  verificationCaseId String
  mediaAssetId       String?
  type               String
  createdAt          DateTime         @default(now())
  verificationCase   VerificationCase @relation(fields: [verificationCaseId], references: [id])
}

model VerificationEvent {
  id                 String           @id @default(cuid())
  verificationCaseId String
  eventType          String
  payload            Json?
  createdAt          DateTime         @default(now())
  verificationCase   VerificationCase @relation(fields: [verificationCaseId], references: [id])
}

model PortfolioItem {
  id             String              @id @default(cuid())
  professionalId String
  title          String
  description    String?
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  mediaAssets    MediaAsset[]
}

model MediaAsset {
  id              String         @id @default(cuid())
  url             String
  mimeType        String
  createdAt       DateTime       @default(now())
  portfolioItemId String?
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id])
}

model Job {
  id              String           @id @default(cuid())
  clientProfileId String
  title           String
  description     String
  state           String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  client          ClientProfile    @relation(fields: [clientProfileId], references: [id])
  location        JobLocation?
  detail          JobDetail?
  media           JobMedia[]
  statusEvents    JobStatusEvent[]
  matches         Match[]
  leads           Lead[]
  quotes          Quote[]
  booking         Booking?
  review          Review?
}

model JobLocation {
  id       String @id @default(cuid())
  jobId    String @unique
  postcode String
  lat      Float?
  lng      Float?
  job      Job    @relation(fields: [jobId], references: [id])
}

model JobDetail {
  id         String  @id @default(cuid())
  jobId      String  @unique
  roomCount  Int?
  complexity String?
  timing     String?
  job        Job     @relation(fields: [jobId], references: [id])
}

model JobMedia {
  id        String   @id @default(cuid())
  jobId     String
  mediaUrl  String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
}

model JobStatusEvent {
  id        String   @id @default(cuid())
  jobId     String
  status    String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
}

model Match {
  id             String   @id @default(cuid())
  jobId          String
  professionalId String
  score          Float
  createdAt      DateTime @default(now())
  job            Job      @relation(fields: [jobId], references: [id])
}

model Lead {
  id             String             @id @default(cuid())
  jobId          String
  professionalId String?
  classification String
  createdAt      DateTime           @default(now())
  job            Job                @relation(fields: [jobId], references: [id])
  eligibility    LeadEligibility?
  priceSnapshot  LeadPriceSnapshot?
  unlocks        LeadUnlock[]
}

model LeadEligibility {
  id        String   @id @default(cuid())
  leadId    String   @unique
  eligible  Boolean
  reason    String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model LeadPriceSnapshot {
  id              String   @id @default(cuid())
  leadId          String   @unique
  pricingVersion  String
  priceGbp        Decimal  @db.Decimal(10, 2)
  creditsRequired Int
  createdAt       DateTime @default(now())
  lead            Lead     @relation(fields: [leadId], references: [id])
}

model Wallet {
  id        String              @id @default(cuid())
  userId    String
  balance   Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id])
  entries   CreditLedgerEntry[]
}

model CreditLedgerEntry {
  id        String   @id @default(cuid())
  walletId  String
  amount    Int
  entryType String
  createdAt DateTime @default(now())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
}

model LeadUnlock {
  id             String   @id @default(cuid())
  leadId         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id])
}

model RefundCase {
  id        String   @id @default(cuid())
  leadId    String?
  status    String
  reason    String?
  createdAt DateTime @default(now())
}

model Quote {
  id             String             @id @default(cuid())
  jobId          String
  professionalId String
  status         String
  createdAt      DateTime           @default(now())
  job            Job                @relation(fields: [jobId], references: [id])
  lines          QuoteLine[]
  events         QuoteStatusEvent[]
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  label     String
  amountGbp Decimal @db.Decimal(10, 2)
  quote     Quote   @relation(fields: [quoteId], references: [id])
}

model QuoteStatusEvent {
  id        String   @id @default(cuid())
  quoteId   String
  status    String
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id])
}

model Conversation {
  id           String        @id @default(cuid())
  jobId        String?
  createdAt    DateTime      @default(now())
  participants Participant[]
  messages     Message[]
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  receipts       MessageReceipt[]
  attachments    Attachment[]
}

model MessageReceipt {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  message   Message   @relation(fields: [messageId], references: [id])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  mimeType  String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
}

model Booking {
  id           String               @id @default(cuid())
  jobId        String               @unique
  quoteId      String
  status       String
  createdAt    DateTime             @default(now())
  job          Job                  @relation(fields: [jobId], references: [id])
  statusEvents BookingStatusEvent[]
}

model BookingStatusEvent {
  id        String   @id @default(cuid())
  bookingId String
  status    String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

model Review {
  id         String                  @id @default(cuid())
  jobId      String                  @unique
  rating     Int
  body       String
  createdAt  DateTime                @default(now())
  job        Job                     @relation(fields: [jobId], references: [id])
  response   ReviewResponse?
  moderation ReviewModerationEvent[]
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  body      String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id])
}

model ReviewModerationEvent {
  id        String   @id @default(cuid())
  reviewId  String
  action    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id])
}

model Product {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  prices    Price[]
}

model Price {
  id        String  @id @default(cuid())
  productId String
  amountGbp Decimal @db.Decimal(10, 2)
  interval  String?
  product   Product @relation(fields: [productId], references: [id])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  tier      String
  status    String
  createdAt DateTime @default(now())
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  amountGbp Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  purchaseId  String?
  provider    String
  providerRef String   @unique
  amountGbp   Decimal  @db.Decimal(10, 2)
  status      String
  createdAt   DateTime @default(now())
}

model Refund {
  id        String   @id @default(cuid())
  paymentId String
  amountGbp Decimal  @db.Decimal(10, 2)
  status    String
  createdAt DateTime @default(now())
}

model Invoice {
  id        String   @id @default(cuid())
  userId    String
  number    String   @unique
  totalGbp  Decimal  @db.Decimal(10, 2)
  vatGbp    Decimal  @db.Decimal(10, 2)
  status    String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  type      String
  payload   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  channel String
  enabled Boolean @default(true)
}

model Report {
  id          String   @id @default(cuid())
  authorId    String
  subjectType String
  subjectId   String
  reason      String
  createdAt   DateTime @default(now())
  author      User     @relation("ReportAuthor", fields: [authorId], references: [id])
}

model ModerationCase {
  id        String   @id @default(cuid())
  reportId  String?
  status    String
  createdAt DateTime @default(now())
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id])
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  consentType String
  granted     Boolean
  createdAt   DateTime @default(now())
}

model DataRequest {
  id          String   @id @default(cuid())
  userId      String
  requestType String
  status      String
  createdAt   DateTime @default(now())
}

model RetentionAction {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  createdAt  DateTime @default(now())
}

model DomainEvent {
  id            String   @id @default(cuid())
  eventType     String
  aggregateType String?
  aggregateId   String?
  payload       Json?
  createdAt     DateTime @default(now())
}