{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    "rootDir": ".",
    "outDir": "./dist/find-a-decorator-backend",

    "baseUrl": ".", 
    "paths": {
      "@pricing/*": ["pricing-engine/*"],
      "@src/*": ["src/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false
  },

  "include": [
    "src/**/*",
    "pricing-engine/**/*"
  ],

  "exclude": [
    "dist",
    "node_modules"
  ]
}
